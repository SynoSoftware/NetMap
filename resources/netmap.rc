#include <windows.h>
#include <commctrl.h>
#include "ids.h"
#include "version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "netmap.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NETMAP_VERSION_NUMBERS
PRODUCTVERSION NETMAP_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NetMap"
            VALUE "FileVersion", NETMAP_VERSION
            VALUE "InternalName", "netmap"
            VALUE "OriginalFilename", "netmap.exe"
            VALUE "ProductName", "NetMap"
            VALUE "ProductVersion", NETMAP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Settings...", IDM_SETTINGS
        MENUITEM "Use as &desktop background", IDM_DESKTOP
        MENUITEM "Enable &whole-PC capture...", IDM_CAPTURE
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Zoom &in\t+", IDM_ZOOM_IN
        MENUITEM "Zoom &out\t-", IDM_ZOOM_OUT
        MENUITEM "&Fit\tCtrl+0", IDM_FIT
        MENUITEM SEPARATOR
        MENUITEM "&Countries", IDM_COUNTRIES
        MENUITEM "C&ities", IDM_CITIES
        MENUITEM SEPARATOR
        MENUITEM "&Map only", IDM_MAP_ONLY
        MENUITEM "&Table only", IDM_TABLE_ONLY
        MENUITEM "Map &and table", IDM_MAP_TABLE
        MENUITEM "&All connections", IDM_ALL_CONNECTIONS
        MENUITEM "More map", IDM_MORE_MAP
        MENUITEM "More table", IDM_MORE_TABLE
    END
    POPUP "&Location"
    BEGIN
        MENUITEM "Map &origin...", IDM_ORIGIN
        MENUITEM SEPARATOR
        MENUITEM "Download &city data", IDM_CITY_DATA
        MENUITEM "&Cancel city download", IDM_CANCEL_CITY
    END
END

// Native shell and DS_CONTROL page composition adapted from Goz Settings.
IDD_SETTINGS DIALOGEX 0, 0, 430, 354
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Search settings:", IDC_SEARCH_LABEL, 7, 9, 70, 10
    EDITTEXT IDC_SEARCH, 84, 7, 278, 14, ES_AUTOHSCROLL
    PUSHBUTTON "&Clear", IDC_CLEAR, 369, 7, 54, 14, WS_DISABLED
    LTEXT "Categories", IDC_PAGES_LABEL, 7, 28, 80, 10
    CONTROL "Categories", IDC_PAGES, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 42, 80, 248
    LTEXT "No settings match your search", IDC_NO_MATCH, 94, 30, 329, 24, NOT WS_VISIBLE
    PUSHBUTTON "&Reset", IDC_RESET_PAGE, 369, 276, 54, 14, WS_DISABLED
    PUSHBUTTON "Reset &all", IDC_RESET_ALL, 7, 298, 65, 14, WS_DISABLED
    DEFPUSHBUTTON "OK", IDOK, 247, 298, 54, 14, WS_DISABLED
    PUSHBUTTON "Cancel", IDCANCEL, 308, 298, 54, 14
    PUSHBUTTON "&Apply", IDC_APPLY, 369, 298, 54, 14, WS_DISABLED
    CONTROL "", IDC_SETTINGS_STATUS, "msctls_statusbar32", WS_CHILD | WS_VISIBLE, 0, 317, 430, 13
END

IDD_SETTINGS_MAP DIALOGEX 0, 0, 329, 240
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VSCROLL | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_HEADING, 0, 0, 320, 12
    LTEXT "", IDC_SECTION, 0, 22, 320, 12
    LTEXT "", IDC_DETAIL_LABEL, 7, 43, 92, 10
    COMBOBOX IDC_DETAIL, 106, 40, 150, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_SPEEDS_LABEL, 7, 66, 92, 10
    COMBOBOX IDC_SPEEDS, 106, 63, 150, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_NOTE, 7, 96, 306, 42
    PUSHBUTTON "", IDC_LOCATION_SETTINGS, 7, 146, 90, 16
END

IDD_SETTINGS_CONNECTIONS DIALOGEX 0, 0, 329, 240
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VSCROLL | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_HEADING, 0, 0, 320, 12
    LTEXT "", IDC_SECTION, 0, 22, 320, 12
    LTEXT "", IDC_BRIGHT_LABEL, 7, 43, 110, 10
    EDITTEXT IDC_BRIGHT, 124, 40, 78, 14, ES_AUTOHSCROLL
    CONTROL "", IDC_BRIGHT_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS, 190, 40, 12, 14
    LTEXT "", IDC_FADE_LABEL, 7, 66, 110, 10
    EDITTEXT IDC_FADE, 124, 63, 78, 14, ES_AUTOHSCROLL
    CONTROL "", IDC_FADE_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS, 190, 63, 12, 14
    LTEXT "", IDC_TRAFFIC, 0, 96, 320, 12
    LTEXT "", IDC_NOTE, 7, 116, 306, 48
END

IDD_SETTINGS_LOCATION DIALOGEX 0, 0, 329, 240
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VSCROLL | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_HEADING, 0, 0, 320, 12
    LTEXT "", IDC_SECTION, 0, 20, 320, 12
    AUTORADIOBUTTON "", IDC_AUTOMATIC, 7, 38, 100, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_MANUAL, 118, 38, 100, 12, WS_TABSTOP
    LTEXT "", IDC_LATITUDE_LABEL, 7, 59, 110, 10
    EDITTEXT IDC_LATITUDE, 124, 56, 116, 14, ES_AUTOHSCROLL
    LTEXT "", IDC_LONGITUDE_LABEL, 7, 80, 110, 10
    EDITTEXT IDC_LONGITUDE, 124, 77, 116, 14, ES_AUTOHSCROLL
    LTEXT "", IDC_ORIGIN_STATUS, 7, 98, 306, 22
    LTEXT "", IDC_NOTE, 7, 124, 306, 30
    LTEXT "", IDC_LOCATION_DATA, 0, 161, 320, 12
    LTEXT "", IDC_DATA_STATUS, 7, 180, 306, 26
    PUSHBUTTON "", IDC_GET_CITY, 7, 210, 90, 16
    PUSHBUTTON "", IDC_CANCEL_CITY_DATA, 104, 210, 90, 16
    LTEXT "", IDC_IMMEDIATE, 7, 232, 306, 28
END

IDD_SETTINGS_DESKTOP DIALOGEX 0, 0, 329, 240
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VSCROLL | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_HEADING, 0, 0, 320, 12
    LTEXT "", IDC_SECTION, 0, 22, 320, 12
    AUTOCHECKBOX "", IDC_DESKTOP_ENABLED, 7, 42, 306, 14, BS_MULTILINE
    LTEXT "", IDC_MONITOR_LABEL, 7, 67, 92, 10
    COMBOBOX IDC_MONITOR, 106, 64, 200, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_NOTE, 7, 96, 306, 58
END

IDD_SETTINGS_SAVER DIALOGEX 0, 0, 329, 240
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VSCROLL | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_HEADING, 0, 0, 320, 12
    LTEXT "", IDC_SECTION, 0, 22, 320, 12
    LTEXT "", IDC_SAVER_STATUS, 7, 42, 306, 36
    PUSHBUTTON "", IDC_INSTALL_SAVER, 7, 86, 126, 16, BS_MULTILINE
    PUSHBUTTON "", IDC_SAVER_WINDOWS, 7, 109, 220, 16, BS_MULTILINE
    PUSHBUTTON "", IDC_PREVIEW_SAVER, 7, 132, 90, 16, BS_MULTILINE
    LTEXT "", IDC_IMMEDIATE, 7, 162, 306, 52
END
